.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust build output. Also covered by src-tauri/.gitignore, repeated here so a clone from
# the repository root cannot accidentally pick up a multi-gigabyte target directory.
src-tauri/target/
src-tauri/gen/schemas/

# Built installers and binaries: releases belong on the releases page, not in history.
*.msi
*.exe
*.dmg
*.AppImage
*.deb

# Sample photos generated by `cargo run --example gen_test_images`.
test-images/

# Mobile icon sets are not built here; regenerate with `npm run tauri icon` if ever needed.
src-tauri/icons/ios/
src-tauri/icons/android/
